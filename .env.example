# WorkYa Dashboard — Variables de entorno requeridas
# Copiar este archivo a .env y completar los valores.
# NUNCA versionar .env (está en .gitignore).

# Conexión a MongoDB Atlas
# Obtener desde: MongoDB Atlas → Connect → Drivers → Connection string
# Formato: mongodb+srv://<usuario>:<contraseña>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=

# Base de datos (por defecto: workya_db)
DB_NAME=workya_db

# Dashboard de salida (para generate_dashboard.py)
DASHBOARD_PATH=index.html
